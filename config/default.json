{
  "app": {
    "name": "rumraket",
    "version": "0.1.0",
    "port": 3000
  },
  "database": {
    "client": "postgresql",
    "connection": {
      "host": "localhost",
      "port": 5432,
      "database": "rumraket_dev",
      "user": "postgres"
    },
    "pool": {
      "min": 2,
      "max": 10
    },
    "migrations": {
      "directory": "../database/migrations"
    },
    "seeds": {
      "directory": "../database/seeds"
    }
  },
  "ai": {
    "provider": "openai",
    "model": "gpt-4",
    "maxTokens": 2048,
    "temperature": 0.7,
    "promptsDir": "../prompts"
  },
  "logging": {
    "level": "debug",
    "format": "json"
  }
}
